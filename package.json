{
  "name": "rector-arena",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "tsx": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "near-sandbox",
      "near-workspaces",
      "secp256k1"
    ]
  },
  "scripts": {
    "arena:run": "tsx packages/harness/src/run.ts",
    "arena:prove": "tsx packages/harness/src/prove.ts",
    "arena:a5llm": "tsx packages/harness/src/spike/a5-llm.ts",
    "arena:web": "pnpm --filter @rector-arena/web dev",
    "build": "pnpm -r build"
  }
}
